### Reproduction source: static survey

```python
import collections, hashlib, json, struct
from pathlib import Path
from capstone import Cs, CS_ARCH_ARM, CS_MODE_ARM, CS_MODE_LITTLE_ENDIAN, CS_GRP_CALL, CS_GRP_JUMP
from capstone.arm import ARM_CC_AL, ARM_CC_INVALID, ARM_OP_IMM, ARM_OP_MEM, ARM_OP_REG, ARM_REG_PC, ARM_INS_LDR, ARM_INS_LDRB, ARM_INS_LDRH, ARM_INS_MOV

root=Path('targets/msm8930-r1.2')
b=(root/'pbl.bin').read_bytes()
assert hashlib.sha256(b).hexdigest()=='c1a7d8ffc9a3b9581953107861e61d9d7d9b9b2c5dafd929571446614884f92e'
symbols=json.loads((root/'symbols.json').read_text())['symbols']
seeds={int(s['address'],0) for s in symbols if s['kind'] in ('function','label')}
seeds.update(range(0,0x20,4))
for base,count in [(0x10ce0,24),(0x10d40,5),(0x124c0,8)]:
    seeds.update(x for x in struct.unpack_from('<'+'I'*count,b,base) if x and x%4==0 and x<len(b))
known_data_starts={int(s['address'],0) for s in symbols if s['kind']=='data'}
# Suppress the observed zero suffix and separately copied initialization templates.
data_ranges=[(0x12574,len(b)),(0x12050,0x124e0)]
no_return={0x1fc,0x6cd8}
md=Cs(CS_ARCH_ARM,CS_MODE_ARM|CS_MODE_LITTLE_ENDIAN);md.detail=True

def walk(blocked):
    queue=collections.deque(sorted(seeds)); seen={}; literals=set(); calls=set(); stops=collections.Counter()
    while queue:
        a=queue.popleft()
        if a in seen: continue
        if a<0 or a+4>len(b) or a%4: stops['outside_or_unaligned']+=1; continue
        if a in blocked or a in known_data_starts or any(lo<=a<hi for lo,hi in data_ranges):
            stops['known_data']+=1; continue
        raw=b[a:a+4]
        if raw in (b'\0'*4,b'\xff'*4): stops['uniform_word']+=1; continue
        insn=next(md.disasm(raw,a),None)
        if insn is None: stops['invalid_decode']+=1; continue
        if insn.mnemonic.startswith(('svc','udf','hvc','smc')):
            stops['exception_instruction_unclassified']+=1; continue
        seen[a]=insn
        conditional=insn.cc not in (ARM_CC_AL,ARM_CC_INVALID)
        next_a=a+4
        # Calls/branches with encoded targets, without indirect target guessing.
        is_call=CS_GRP_CALL in insn.groups
        is_jump=CS_GRP_JUMP in insn.groups
        if (is_call or is_jump) and insn.operands and insn.operands[0].type==ARM_OP_IMM:
            dst=insn.operands[0].imm
            if not insn.mnemonic.startswith('blx'):
                queue.append(dst)
                if is_call: calls.add(dst)
            else: stops['state_switch_unclassified']+=1
            if conditional or (is_call and dst not in no_return): queue.append(next_a)
            continue
        literal=None
        width={ARM_INS_LDR:4,ARM_INS_LDRB:1,ARM_INS_LDRH:2}.get(insn.id)
        if width and len(insn.operands)>=2:
            m=insn.operands[1]
            if m.type==ARM_OP_MEM and m.mem.base==ARM_REG_PC and not m.mem.index:
                loc=a+8+m.mem.disp
                if 0<=loc<=len(b)-width:
                    literals.update(range(loc & ~3,(loc+width+3)&~3,4))
                    literal=int.from_bytes(b[loc:loc+width],'little')
        _,writes=insn.regs_access()
        writes_pc=ARM_REG_PC in writes
        if insn.id==ARM_INS_LDR and len(insn.operands)>1 and insn.operands[0].type==ARM_OP_REG and insn.operands[0].reg==ARM_REG_PC and literal is not None:
            if literal%4==0: queue.append(literal)
            else: stops['state_switch_unclassified']+=1
            if conditional: queue.append(next_a)
        elif insn.id==ARM_INS_MOV and len(insn.operands)>1 and insn.operands[0].type==ARM_OP_REG and insn.operands[0].reg==ARM_REG_PC and insn.operands[1].type==ARM_OP_IMM:
            queue.append(insn.operands[1].imm)
            if conditional: queue.append(next_a)
        elif is_call or is_jump or writes_pc:
            # Deliberately stop at indirect calls, returns and computed branches.
            stops['indirect_pc_or_return']+=1
            if conditional: queue.append(next_a)
        else:
            queue.append(next_a)
    return seen,literals,calls,stops

blocked=set()
for iteration in range(8):
    seen,literals,calls,stops=walk(blocked)
    extra=literals-blocked
    if not extra:break
    blocked|=extra
else: raise RuntimeError('literal exclusion did not converge')
assert not(set(seen)&blocked)
print('METHOD: static direct-control-flow survey; not execution or a certified code/data partition.')
print('Known symbol/vector/callback seeds:',len(seeds))
print('Literal exclusion passes:',iteration+1)
print('Distinct followed instruction addresses:',len(seen))
print('Covered instruction bytes:',len(seen)*4, f'({len(seen)*4/1024:.2f} KiB)')
print('Distinct direct call targets:',len(calls))
print('Referenced literal words excluded:',len(blocked))
print('Stops:',dict(stops))
print('Pages: address, covered instruction bytes')
for page in range(0,len(b),4096):
    n=sum(page<=a<page+4096 for a in seen)*4
    if n:print(f'0x{page:05x} {n}')
Path('out/code-survey/instruction-addresses.json').write_text(json.dumps(sorted(seen),indent=2)+'\n')
Path('out/code-survey/instructions.asm').write_text('\n'.join(f'{a:08x} {i.bytes.hex()} {i.mnemonic} {i.op_str}' for a,i in sorted(seen.items()))+'\n')

```

