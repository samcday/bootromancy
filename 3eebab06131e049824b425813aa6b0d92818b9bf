.syntax unified
.arm
.section .text,"ax",%progbits
.global copy_aligned_words
.type copy_aligned_words,%function
copy_aligned_words:
    push {r0-r10, lr}
    mov r8, r0
    mov r9, r1
    mov r10, r2
    cmp r10, #0x20
    bge .Lblock
.Lcheck:
    cmp r10, #0
    bgt .Lword
.Lreturn:
    pop {r0-r10, pc}
.Lblock:
    ldmia r9!, {r0-r7}
    stmia r8!, {r0-r7}
    sub r10, r10, #0x20
    cmp r10, #0x20
    bge .Lblock
    blt .Lcheck
.Lword:
    ldmia r9!, {r0}
    stmia r8!, {r0}
    sub r10, r10, #4
    cmp r10, #0
    bgt .Lword
    ble .Lreturn
.size copy_aligned_words, .-copy_aligned_words

